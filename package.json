{
  "name": "adonisjs-packages",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "bootstrap": "turbo build --filter=./packages/* && pnpm --filter playground bootstrap",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck && tsc -p tsconfig.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "changeset": "changeset",
    "release": "turbo build --filter='./packages/*' && changeset publish",
    "docs:pull": "sh scripts/pull-docs.sh"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@julr/tooling-configs": "^6.4.0",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "catalog:",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.14.0"
}

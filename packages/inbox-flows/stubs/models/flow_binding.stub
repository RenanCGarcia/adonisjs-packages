import { compose } from '@adonisjs/core/helpers'
import { belongsTo } from '@adonisjs/lucid/orm'
import type { BelongsTo } from '@adonisjs/lucid/types/relations'
import { withInboxFlowBinding } from '@enzopita/adonisjs-inbox-flows/mixins'
import { InboxFlowBindingSchema } from '#database/schema'
import Flow from '#models/inbox/flow'

export default class FlowBinding extends compose(InboxFlowBindingSchema, withInboxFlowBinding()) {
  static table = 'inbox_flow_bindings'

  @belongsTo(() => Flow)
  declare flow: BelongsTo<typeof Flow>
}

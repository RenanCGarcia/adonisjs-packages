  },
  "paths": {
    "/api/v1/auth/signup": {
      "post": {
        "operationId": "auth.new_account.store",
        "tags": [
          "auth"
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "$ref": "#/components/schemas/User"
                        },
                        "token": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "user",
                        "token"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "const": "E_EMAIL_TAKEN"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "const": "E_DISPOSABLE_EMAIL"
                        },
                        "message": {
                          "type": "string"
                        },
                        "domain": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "code",
                        "message",
                        "domain"
                      ]
                    },
                    {
                      "$ref": "#/components/schemas/ValidationError"
                    }
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fullName": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 32
                  },
                  "passwordConfirmation": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 32
                  }
                },
                "additionalProperties": false,
                "required": [
                  "email",
                  "password",
                  "passwordConfirmation"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "auth.access_tokens.store",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "OK",

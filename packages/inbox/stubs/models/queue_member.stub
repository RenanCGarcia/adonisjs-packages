import { compose } from '@adonisjs/core/helpers'
import { belongsTo } from '@adonisjs/lucid/orm'
import type { BelongsTo } from '@adonisjs/lucid/types/relations'
import { withInboxQueueMember } from '@enzopita/adonisjs-inbox/mixins'
import { InboxQueueMemberSchema } from '#database/schema'
import Attendant from '#models/inbox/attendant'
import Queue from '#models/inbox/queue'

export default class QueueMember extends compose(InboxQueueMemberSchema, withInboxQueueMember()) {
  static table = 'inbox_queue_members'

  @belongsTo(() => Queue)
  declare queue: BelongsTo<typeof Queue>

  @belongsTo(() => Attendant)
  declare attendant: BelongsTo<typeof Attendant>
}

import { compose } from '@adonisjs/core/helpers'
import { belongsTo } from '@adonisjs/lucid/orm'
import type { BelongsTo } from '@adonisjs/lucid/types/relations'
import { withInboxTicketEvent } from '@enzopita/adonisjs-inbox/mixins'
import { InboxTicketEventSchema } from '#database/schema'
import Attendant from '#models/inbox/attendant'
import Ticket from '#models/inbox/ticket'

export default class TicketEvent extends compose(InboxTicketEventSchema, withInboxTicketEvent()) {
  static table = 'inbox_ticket_events'

  @belongsTo(() => Ticket)
  declare ticket: BelongsTo<typeof Ticket>

  @belongsTo(() => Attendant, { foreignKey: 'actorId' })
  declare actor: BelongsTo<typeof Attendant>
}

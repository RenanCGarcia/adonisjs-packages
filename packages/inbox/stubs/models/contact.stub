{{{
  exports({ to: app.modelsPath('inbox', 'contact.ts') })
}}}
import { compose } from '@adonisjs/core/helpers'
import { belongsTo, hasMany } from '@adonisjs/lucid/orm'
import type { BelongsTo, HasMany } from '@adonisjs/lucid/types/relations'
import { withInboxContact } from '@enzopita/adonisjs-inbox/mixins'
import { InboxContactSchema } from '#database/schema'
import Channel from '#models/inbox/channel'
import Conversation from '#models/inbox/conversation'

export default class Contact extends compose(InboxContactSchema, withInboxContact()) {
  static table = 'inbox_contacts'

  @belongsTo(() => Channel)
  declare channel: BelongsTo<typeof Channel>

  @hasMany(() => Conversation)
  declare conversations: HasMany<typeof Conversation>
}

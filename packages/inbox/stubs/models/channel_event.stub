import { compose } from '@adonisjs/core/helpers'
import { belongsTo } from '@adonisjs/lucid/orm'
import type { BelongsTo } from '@adonisjs/lucid/types/relations'
import { withInboxChannelEvent } from '@enzopita/adonisjs-inbox/mixins'
import { InboxChannelEventSchema } from '#database/schema'
import Channel from '#models/inbox/channel'

export default class ChannelEvent extends compose(InboxChannelEventSchema, withInboxChannelEvent()) {
  static table = 'inbox_channel_events'

  @belongsTo(() => Channel)
  declare channel: BelongsTo<typeof Channel>
}

# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database: sqlite (tmp/db.sqlite3) by default, or pg with the compose service (pnpm db:up)
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=55432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=playground

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000